# Python bytecode and packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
site/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python tooling and test artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Node.js and Next.js
node_modules/
.next/
out/
.nuxt/
.svelte-kit/
.turbo/
.vercel/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files and local credentials
.env
.env.*
!.env.example
!.env.template
!.env.sample

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# General caches, logs, and temporary files
.cache/
tmp/
temp/
*.log
*.pid

# Generated benchmark outputs (benchmark source/config stays trackable)
.benchmarks/
benchmark-results/
benchmark_outputs/
benchmarks/output/
benchmarks/outputs/
benchmarks/results/

# Impeccable ephemeral runtime files; shared design artifacts remain trackable
.impeccable/runtime/
.impeccable/cache/
.impeccable/tmp/
.impeccable/screenshots/
.impeccable/live/
.impeccable/*.log
.impeccable/*.pid
impeccable-screenshots/

# Local assistant indexes and conversational memory
.memsearch/
.tokensave/
